# ── Base de datos (Supabase → Connect) ──────────────────────────────
# Transaction pooler (puerto 6543), con ?pgbouncer=true al final. La usa la app.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler o conexión directa (puerto 5432). La usan las migraciones.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Supabase Auth (Project Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Opcional: permite mandar la invitación al equipo por correo. Solo servidor; nunca la expongas.
SUPABASE_SERVICE_ROLE_KEY=""

# URL pública de la app (sin diagonal final). Se usa en enlaces de reservas, citas y correos.
NEXT_PUBLIC_APP_URL="https://tu-dominio.com"

# ── Suscripciones (Stripe) ──────────────────────────────────────────
# Sin STRIPE_SECRET_KEY el cobro queda apagado y todas las funciones disponibles.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC=""   # price_... del plan Básico ($299/mes)
STRIPE_PRICE_PRO=""     # price_... del plan Pro ($599/mes)

# ── Mensajes automáticos ────────────────────────────────────────────
# Protege /api/cron/mensajes (la tarea programada manda "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=""
# WhatsApp Cloud API de Meta. Sin esto, los mensajes se envían con un toque desde el panel.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_API_VERSION="v23.0"
# WHATSAPP_TPL_LANGUAGE="es_MX"
# Nombres de plantilla si usas otros: WHATSAPP_TPL_CONFIRMATION, WHATSAPP_TPL_REMINDER_24H,
# WHATSAPP_TPL_REMINDER_2H, WHATSAPP_TPL_NO_SHOW, WHATSAPP_TPL_REVIEW, WHATSAPP_TPL_REBOOK, WHATSAPP_TPL_BIRTHDAY,
# WHATSAPP_TPL_STAMP_ALMOST, WHATSAPP_TPL_STAMP_REWARD, WHATSAPP_TPL_STAMP_WELCOME, WHATSAPP_TPL_QUEUE_NEXT, WHATSAPP_TPL_WAITLIST

# ── Seguridad de reservas públicas (opcional, Cloudflare Turnstile) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Tú como dueño de BarberOS ────────────────────────────────────────
# Correos con acceso a /admin, separados por comas.
SUPERADMIN_EMAILS=""
# Datos para el aviso de privacidad y los términos.
LEGAL_NAME=""
LEGAL_EMAIL=""
LEGAL_ADDRESS=""

# ── Solo desarrollo ─────────────────────────────────────────────────
# Entra directo con este usuario, sin login. Se ignora en producción.
# DEV_AUTH_EMAIL="tu@email.com"
