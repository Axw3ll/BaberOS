// BarberOS — modelo de datos
// · Fechas de citas en UTC. Horarios semanales en minutos locales (9:30 → 570).
// · Dinero en Decimal(10,2).
// · Precios y nombres se copian en citas y ventas para conservar el historial.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  BARBER
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  WALK_IN
  PHONE
  ONLINE
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  INTERNAL_USE
}

enum SaleStatus {
  PAID
  VOIDED
}

enum SaleItemKind {
  SERVICE
  PRODUCT
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

// ── Cuentas y barberías ──────────────────────────────────────────────

/// id = auth.users.id de Supabase
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  ownedShops Barbershop[] @relation("ShopOwner")
  staff      Staff[]

  @@map("users")
}

model Barbershop {
  id        String  @id @default(uuid()) @db.Uuid
  ownerId   String  @db.Uuid
  name      String
  slug      String  @unique
  phone     String?
  address   String?
  timezone  String  @default("America/Mexico_City")
  taxRate   Decimal @default(0.16) @db.Decimal(5, 4)

  slotMinutes      Int @default(15)
  minNoticeMinutes Int @default(60)
  maxAdvanceDays   Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User            @relation("ShopOwner", fields: [ownerId], references: [id])
  hours         ShopHours[]
  closures      Closure[]
  staff         Staff[]
  services      Service[]
  customers     Customer[]
  appointments  Appointment[]
  products      Product[]
  stockMoves    StockMovement[]
  sales         Sale[]

  @@index([ownerId])
  @@map("barbershops")
}

/// Horario de apertura. Varias filas por día = horario partido.
model ShopHours {
  id          String @id @default(uuid()) @db.Uuid
  shopId      String @db.Uuid
  weekday     Int // 0 domingo … 6 sábado
  startMinute Int
  endMinute   Int

  shop Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, weekday])
  @@map("shop_hours")
}

/// Cierres de toda la barbería (festivos, remodelación)
model Closure {
  id       String   @id @default(uuid()) @db.Uuid
  shopId   String   @db.Uuid
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  shop Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, startsAt])
  @@map("closures")
}

// ── Equipo ───────────────────────────────────────────────────────────

/// Persona que trabaja en una barbería. El dueño también es Staff (OWNER).
/// Si se crea con email y sin cuenta, se vincula cuando esa persona se registra.
model Staff {
  id         String  @id @default(uuid()) @db.Uuid
  shopId     String  @db.Uuid
  userId     String? @db.Uuid
  email      String?
  role       Role    @default(BARBER)
  name       String
  phone      String?
  takesAppointments Boolean @default(true)
  active     Boolean @default(true)
  serviceCommission Decimal @default(0.40) @db.Decimal(5, 4)
  productCommission Decimal @default(0.10) @db.Decimal(5, 4)
  createdAt  DateTime @default(now())

  shop         Barbershop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedule     StaffHours[]
  timeOff      TimeOff[]
  services     StaffService[]
  appointments Appointment[]
  saleItems    SaleItem[]
  salesCharged Sale[]         @relation("ChargedBy")

  @@unique([shopId, userId])
  @@unique([shopId, email])
  @@index([shopId, active])
  @@map("staff")
}

/// Turno semanal. Varias filas por día = turno partido (comida en medio).
model StaffHours {
  id          String @id @default(uuid()) @db.Uuid
  staffId     String @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
  @@map("staff_hours")
}

model TimeOff {
  id       String   @id @default(uuid()) @db.Uuid
  staffId  String   @db.Uuid
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt])
  @@map("time_off")
}

// ── Servicios ────────────────────────────────────────────────────────

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @db.Uuid
  name        String
  description String?
  minutes     Int
  price       Decimal  @db.Decimal(10, 2)
  bookableOnline Boolean @default(true)
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  shop         Barbershop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff        StaffService[]
  bookedIn     AppointmentService[]
  soldIn       SaleItem[]

  @@index([shopId, active])
  @@map("services")
}

/// Qué servicios hace cada barbero
model StaffService {
  staffId   String @db.Uuid
  serviceId String @db.Uuid

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

// ── Clientes y citas ─────────────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  name      String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  shop         Barbershop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  sales        Sale[]

  @@unique([shopId, phone])
  @@index([shopId, name])
  @@map("customers")
}

model Appointment {
  id         String            @id @default(uuid()) @db.Uuid
  shopId     String            @db.Uuid
  staffId    String            @db.Uuid
  customerId String            @db.Uuid
  startsAt   DateTime
  endsAt     DateTime
  status     AppointmentStatus @default(CONFIRMED)
  source     AppointmentSource @default(WALK_IN)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  shop     Barbershop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff    Staff                @relation(fields: [staffId], references: [id])
  customer Customer             @relation(fields: [customerId], references: [id])
  services AppointmentService[]
  sale     Sale?

  @@index([shopId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId])
  @@map("appointments")
}

model AppointmentService {
  id            String  @id @default(uuid()) @db.Uuid
  appointmentId String  @db.Uuid
  serviceId     String  @db.Uuid
  name          String
  minutes       Int
  price         Decimal @db.Decimal(10, 2)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@index([appointmentId])
  @@map("appointment_services")
}

// ── Productos e inventario ───────────────────────────────────────────

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  name      String
  brand     String?
  category  String? // Ceras, Geles, Pomadas, Aceites…
  sku       String?
  price     Decimal  @db.Decimal(10, 2)
  cost      Decimal? @db.Decimal(10, 2)
  stock     Int      @default(0)
  minStock  Int      @default(3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop   Barbershop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  moves  StockMovement[]
  soldIn SaleItem[]

  @@unique([shopId, sku])
  @@index([shopId, active])
  @@map("products")
}

/// Kardex. quantity > 0 entra, < 0 sale.
model StockMovement {
  id         String            @id @default(uuid()) @db.Uuid
  shopId     String            @db.Uuid
  productId  String            @db.Uuid
  type       StockMovementType
  quantity   Int
  stockAfter Int
  unitCost   Decimal?          @db.Decimal(10, 2)
  note       String?
  saleId     String?           @db.Uuid
  createdAt  DateTime          @default(now())

  shop    Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale    Sale?      @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ── Ventas ───────────────────────────────────────────────────────────

model Sale {
  id            String     @id @default(uuid()) @db.Uuid
  shopId        String     @db.Uuid
  folio         Int
  customerId    String?    @db.Uuid
  appointmentId String?    @unique @db.Uuid
  chargedById   String?    @db.Uuid
  status        SaleStatus @default(PAID)
  subtotal      Decimal    @db.Decimal(10, 2)
  discount      Decimal    @default(0) @db.Decimal(10, 2)
  tax           Decimal    @db.Decimal(10, 2)
  tip           Decimal    @default(0) @db.Decimal(10, 2)
  total         Decimal    @db.Decimal(10, 2)
  createdAt     DateTime   @default(now())

  shop        Barbershop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appointment Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  chargedBy   Staff?          @relation("ChargedBy", fields: [chargedById], references: [id], onDelete: SetNull)
  items       SaleItem[]
  payments    Payment[]
  stockMoves  StockMovement[]

  @@unique([shopId, folio])
  @@index([shopId, createdAt])
  @@map("sales")
}

model SaleItem {
  id         String       @id @default(uuid()) @db.Uuid
  saleId     String       @db.Uuid
  kind       SaleItemKind
  serviceId  String?      @db.Uuid
  productId  String?      @db.Uuid
  staffId    String?      @db.Uuid
  name       String
  quantity   Int          @default(1)
  unitPrice  Decimal      @db.Decimal(10, 2)
  total      Decimal      @db.Decimal(10, 2)
  commission Decimal      @default(0) @db.Decimal(10, 2)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  staff   Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([staffId])
  @@map("sale_items")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  saleId    String        @db.Uuid
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("payments")
}
